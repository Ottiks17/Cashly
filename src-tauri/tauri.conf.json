{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Моя бухгалтерия",
  "version": "0.1.0",
  "identifier": "local.moya.buhgalteriya",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Моя бухгалтерия",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "languages": [
          "Russian"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFBNzlFNkJBMEY2Q0M3RUMKUldUc3gyd1B1dVo1R25EaUJvbCtMd2RqOGVjWGN2a3o1anEzWFYrcGxwNTByYVhTaDI2UTRMSjYK",
      "endpoints": [
        "https://github.com/Ottiks17/Cashly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}